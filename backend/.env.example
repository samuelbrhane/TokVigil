# Application
APP_NAME="AI Usage Control"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# API
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_usage_control

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Token settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Rate limiting
RATE_LIMIT_EVALUATE_PER_MINUTE=1000
RATE_LIMIT_USAGE_PER_MINUTE=1000
