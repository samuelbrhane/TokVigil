{
  "name": "tokvigil",
  "version": "0.1.0",
  "description": "TypeScript SDK for TokVigil - AI usage control platform",
  "license": "MIT",
  "author": "TokVigil <support@tokvigil.com>",
  "homepage": "https://tokvigil.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelbrhane/tokvigil"
  },
  "bugs": {
    "url": "https://github.com/samuelbrhane/tokvigil/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "rate-limiting",
    "usage-control",
    "openai",
    "anthropic",
    "tokvigil"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
