{
  "name": "tokenfence",
  "version": "0.1.0",
  "description": "TypeScript SDK for TokenFence - AI usage control platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "rate-limiting",
    "usage-control",
    "openai",
    "anthropic",
    "tokenfence"
  ],
  "author": "TokenFence <support@tokenfence.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelbrhane/tokenfence"
  },
  "homepage": "https://tokenfence.io",
  "bugs": {
    "url": "https://github.com/samuelbrhane/tokenfence/issues"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
