{
  "TokenFence Import": {
    "prefix": "tfimport",
    "body": ["from tokenfence import TokenFence", "", "$0"],
    "description": "Import TokenFence SDK",
  },
  "TokenFence Initialize": {
    "prefix": "tfinit",
    "body": [
      "from tokenfence import TokenFence",
      "",
      "tf = TokenFence(",
      "    api_key=\"${1:your_api_key}\"",
      ")",
      "",
      "$0",
    ],
    "description": "Initialize TokenFence client",
  },
  "TokenFence Evaluate": {
    "prefix": "tfeval",
    "body": [
      "result = tf.evaluate(",
      "    user_id=\"${1:user_id}\",",
      "    model=\"${2:gpt-4o-mini}\",",
      "    plan=\"${3:free}\",",
      "    feature=\"${4:chat}\"",
      ")",
      "",
      "if result.allowed:",
      "    $0",
      "else:",
      "    print(f\"Blocked: {result.message}\")",
    ],
    "description": "Evaluate if request is allowed",
  },
  "TokenFence Log Usage": {
    "prefix": "tflog",
    "body": [
      "tf.log_usage(",
      "    request_id=\"${1:request_id}\",",
      "    user_id=\"${2:user_id}\",",
      "    model=\"${3:gpt-4o-mini}\",",
      "    input_tokens=${4:100},",
      "    output_tokens=${5:50},",
      "    status=\"${6:allowed}\",",
      "    plan=\"${7:free}\",",
      "    feature=\"${8:chat}\"",
      ")",
      "$0",
    ],
    "description": "Log AI usage after completion",
  },
  "TokenFence Full Flow": {
    "prefix": "tfflow",
    "body": [
      "from tokenfence import TokenFence",
      "import uuid",
      "",
      "tf = TokenFence(api_key=\"${1:your_api_key}\")",
      "",
      "# Check if request is allowed",
      "result = tf.evaluate(",
      "    user_id=\"${2:user_id}\",",
      "    model=\"${3:gpt-4o-mini}\",",
      "    plan=\"${4:free}\",",
      "    feature=\"${5:chat}\",",
      "    input_tokens=${6:100}",
      ")",
      "",
      "if result.allowed:",
      "    # Make your AI call here",
      "    request_id = str(uuid.uuid4())",
      "    ",
      "    # Example: response = openai.chat.completions.create(...)",
      "    $0",
      "    ",
      "    # Log the usage",
      "    tf.log_usage(",
      "        request_id=request_id,",
      "        user_id=\"${2:user_id}\",",
      "        model=\"${3:gpt-4o-mini}\",",
      "        input_tokens=${6:100},",
      "        output_tokens=50,",
      "        status=\"allowed\",",
      "        plan=\"${4:free}\",",
      "        feature=\"${5:chat}\"",
      "    )",
      "else:",
      "    print(f\"Blocked: {result.reason_code} - {result.message}\")",
    ],
    "description": "Complete TokenFence flow with evaluate and log",
  },
  "TokenFence Usage Summary": {
    "prefix": "tfsummary",
    "body": [
      "summary = tf.get_usage_summary()",
      "print(f\"Total requests: {summary.total_requests}\")",
      "print(f\"Total tokens: {summary.total_tokens}\")",
      "print(f\"Total cost: \\${summary.total_cost_usd}\")",
      "$0",
    ],
    "description": "Get usage summary",
  },
  "TokenFence Usage By User": {
    "prefix": "tfbyuser",
    "body": [
      "by_user = tf.get_usage_by_user()",
      "for user in by_user.items:",
      "    print(f\"{user.group}: {user.requests} requests, {user.tokens} tokens\")",
      "$0",
    ],
    "description": "Get usage grouped by user",
  },
  "TokenFence Check and Call": {
    "prefix": "tfcheck",
    "body": [
      "def call_ai():",
      "    # Your AI call here",
      "    return openai.chat.completions.create(",
      "        model=\"${1:gpt-4o-mini}\",",
      "        messages=[{\"role\": \"user\", \"content\": \"${2:Hello}\"}]",
      "    )",
      "",
      "result, response = tf.check_and_call(",
      "    user_id=\"${3:user_id}\",",
      "    model=\"${1:gpt-4o-mini}\",",
      "    ai_function=call_ai,",
      "    plan=\"${4:free}\",",
      "    feature=\"${5:chat}\"",
      ")",
      "",
      "if result.allowed:",
      "    print(response.choices[0].message.content)",
      "else:",
      "    print(f\"Blocked: {result.message}\")",
      "$0",
    ],
    "description": "Check, call AI, and log automatically",
  },
  "TokenFence Error Handling": {
    "prefix": "tferror",
    "body": [
      "from tokenfence import TokenFence, RateLimitError, AuthenticationError, TokenFenceError",
      "",
      "tf = TokenFence(api_key=\"${1:your_api_key}\")",
      "",
      "try:",
      "    result = tf.evaluate(",
      "        user_id=\"${2:user_id}\",",
      "        model=\"${3:gpt-4o-mini}\"",
      "    )",
      "    $0",
      "except AuthenticationError as e:",
      "    print(f\"Invalid API key: {e.message}\")",
      "except RateLimitError as e:",
      "    print(f\"Rate limited. Retry after {e.retry_after} seconds\")",
      "except TokenFenceError as e:",
      "    print(f\"Error: {e.message}\")",
    ],
    "description": "TokenFence with error handling",
  },
  "TokenFence Blocked Requests": {
    "prefix": "tfblocked",
    "body": [
      "blocked = tf.get_blocked_requests()",
      "print(f\"Total blocked: {blocked.total}\")",
      "for record in blocked.items:",
      "    print(f\"{record.user_id}: {record.reason_code}\")",
      "$0",
    ],
    "description": "Get blocked requests",
  },
}
