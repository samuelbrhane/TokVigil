  "TokVigil Full Flow": {
    "prefix": "tvflow",
    "body": [
      "from tokvigil import TokVigil",
      "import uuid",
      "",
      "tv = TokVigil(api_key=\"${1:your_api_key}\")",
      "",
      "# Check if request is allowed",
      "result = tv.evaluate(",
      "    user_id=\"${2:user_id}\",",
      "    model=\"${3:gpt-4o-mini}\",",
      "    plan=\"${4:free}\",",
      "    feature=\"${5:chat}\",",
      "    input_tokens=${6:100}",
      ")",
      "",
      "if result.allowed:",
      "    # Make your AI call here",
      "    request_id = str(uuid.uuid4())",
      "    ",
      "    # Example: response = openai.chat.completions.create(...)",
      "    $0",
      "    ",
      "    # Log the usage",
      "    tv.log_usage(",
      "        request_id=request_id,",
      "        user_id=\"${2:user_id}\",",
      "        model=\"${3:gpt-4o-mini}\",",
      "        input_tokens=${6:100},",
      "        output_tokens=50,",
      "        status=\"allowed\",",
      "        plan=\"${4:free}\",",
      "        feature=\"${5:chat}\"",
      "    )",
      "else:",
      "    print(f\"Blocked: {result.reason_code} - {result.message}\")",
    ],
    "description": "Complete TokVigil flow with evaluate and log",
  },
  "TokVigil Usage Summary": {
    "prefix": "tvsummary",
    "body": [
      "summary = tv.get_usage_summary()",
      "print(f\"Total requests: {summary.total_requests}\")",
      "print(f\"Total tokens: {summary.total_tokens}\")",
      "print(f\"Total cost: \\${summary.total_cost_usd}\")",
      "$0",
    ],
    "description": "Get usage summary",
  },
  "TokVigil Usage By User": {
    "prefix": "tvbyuser",
    "body": [
      "by_user = tv.get_usage_by_user()",
      "for user in by_user.items:",
      "    print(f\"{user.group}: {user.requests} requests, {user.tokens} tokens\")",
      "$0",
    ],
    "description": "Get usage grouped by user",
  },
  "TokVigil Check and Call": {
    "prefix": "tvcheck",
    "body": [
      "def call_ai():",
      "    # Your AI call here",
      "    return openai.chat.completions.create(",
      "        model=\"${1:gpt-4o-mini}\",",
      "        messages=[{\"role\": \"user\", \"content\": \"${2:Hello}\"}]",
      "    )",
      "",
      "result, response = tv.check_and_call(",
      "    user_id=\"${3:user_id}\",",
      "    model=\"${1:gpt-4o-mini}\",",
      "    ai_function=call_ai,",
      "    plan=\"${4:free}\",",
      "    feature=\"${5:chat}\"",
      ")",
      "",
      "if result.allowed:",
      "    print(response.choices[0].message.content)",
      "else:",
      "    print(f\"Blocked: {result.message}\")",
      "$0",
    ],
    "description": "Check, call AI, and log automatically",
  },
  "TokVigil Error Handling": {
    "prefix": "tverror",
    "body": [
      "from tokvigil import TokVigil, RateLimitError, AuthenticationError, TokVigilError",
      "",
      "tv = TokVigil(api_key=\"${1:your_api_key}\")",
      "",
      "try:",
      "    result = tv.evaluate(",
      "        user_id=\"${2:user_id}\",",
      "        model=\"${3:gpt-4o-mini}\"",
      "    )",
      "    $0",
      "except AuthenticationError as e:",
      "    print(f\"Invalid API key: {e.message}\")",
      "except RateLimitError as e:",
      "    print(f\"Rate limited. Retry after {e.retry_after} seconds\")",
      "except TokVigilError as e:",
      "    print(f\"Error: {e.message}\")",
    ],
    "description": "TokVigil with error handling",
  },
  "TokVigil Blocked Requests": {
    "prefix": "tvblocked",
    "body": [
      "blocked = tv.get_blocked_requests()",
      "print(f\"Total blocked: {blocked.total}\")",
      "for record in blocked.items:",
      "    print(f\"{record.user_id}: {record.reason_code}\")",
      "$0",
    ],
    "description": "Get blocked requests",
  },
